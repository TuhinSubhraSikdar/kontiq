# This is an example .env file for local development. Copy this file to .env and update the values as needed.
# Django
DJANGO_SECRET_KEY=change-me-for-any-non-local-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Database (omit to use db.sqlite3)
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=0

# Celery and Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# AI provider defaults (generation is introduced in a later phase)
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_RETRIES=2
AI_TASK_MAX_ATTEMPTS=3
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8000

# Upload policy (reference uploads are introduced in a later phase)
MAX_REFERENCE_UPLOAD_MB=10
